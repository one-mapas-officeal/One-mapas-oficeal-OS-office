# Copie para .env e preencha. NUNCA envie o .env para o GitHub.

# Token do bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=

# ID do servidor onde os comandos serão registrados
GUILD_ID=

# Cargo da equipe que atende os tickets
STAFF_ROLE_ID=

# (opcional) Categoria onde os canais de ticket serão criados
TICKET_CATEGORY_ID=

# (opcional) Canal que recebe os logs e as transcrições
LOG_CHANNEL_ID=
