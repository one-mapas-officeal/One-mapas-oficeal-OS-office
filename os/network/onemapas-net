#!/bin/bash
# onemapas-net: detecta as placas de rede, carrega os drivers (módulos do kernel Linux)
# e avisa quando falta firmware. Roda na inicialização (onemapas-net.service) e também à mão:
#   sudo onemapas-net          -> detecta e carrega
#   onemapas-net --relatorio   -> só mostra o que encontrou
set -u
LOG=/var/log/onemapas-net.log
RELATORIO=0
[ "${1:-}" = "--relatorio" ] && RELATORIO=1

log() { echo "[onemapas-net] $*"; [ -w "$(dirname $LOG)" ] && echo "$(date '+%F %T') $*" >> "$LOG"; }

# Tabela: fabricante:dispositivo (prefixo) -> módulo do kernel
# PCI = placas internas, USB = adaptadores USB
declare -A PCI_MOD=(
  [8086:]=iwlwifi        # Intel Wi-Fi (o e1000e/igc abaixo têm prioridade para cabo)
  [8086:15]=e1000e [8086:10]=e1000e [8086:0d]=e1000e [8086:15f]=igc [8086:125]=igc
  [10ec:8168]=r8169 [10ec:8161]=r8169 [10ec:8136]=r8169 [10ec:8125]=r8169
  [10ec:c8]=rtw88_pci [10ec:b8]=rtw88_pci [10ec:88]=rtw89_pci [10ec:52]=rtw89_pci
  [168c:]=ath9k [168c:003e]=ath10k_pci [168c:0042]=ath10k_pci [17cb:1101]=ath11k_pci
  [14e4:43]=brcmfmac [14e4:16]=tg3 [14e4:17]=tg3
  [14c3:]=mt7921e [1969:]=alx [11ab:]=sky2 [1af4:1000]=virtio_net [1af4:1041]=virtio_net
)
declare -A USB_MOD=(
  [0bda:8179]=r8188eu [0bda:b812]=rtw88_8822bu [0bda:c811]=rtw88_8821cu [0bda:8153]=r8152
  [0e8d:7961]=mt7921u [148f:]=rt2800usb [0cf3:9271]=ath9k_htc [2357:]=rtw88_8822bu
  [0b95:]=ax88179_178a [0424:]=lan78xx
)

achar_mod() {  # $1=id  $2=nome da tabela
  local id=$1 melhor="" tam=0 chave
  local -n T=$2
  for chave in "${!T[@]}"; do
    if [[ "$id" == "$chave"* ]] && (( ${#chave} > tam )); then melhor=${T[$chave]}; tam=${#chave}; fi
  done
  echo "$melhor"
}

carregar() {
  local mod=$1 desc=$2
  if lsmod | grep -q "^${mod//-/_} "; then log "OK  $desc -> $mod (já carregado)"; return; fi
  if (( RELATORIO )); then log "--  $desc -> $mod (não carregado)"; return; fi
  if modprobe "$mod" 2>/dev/null; then log "OK  $desc -> $mod (carregado agora)"
  else log "ERRO $desc -> $mod (módulo não existe neste kernel)"; fi
}

log "Procurando placas de rede…"
if command -v lspci >/dev/null; then
  while read -r linha; do
    id=$(grep -oE '\[[0-9a-f]{4}:[0-9a-f]{4}\]' <<<"$linha" | tail -1 | tr -d '[]')
    [ -z "$id" ] && continue
    mod=$(achar_mod "$id" PCI_MOD)
    desc=$(cut -d' ' -f2- <<<"$linha" | cut -c1-70)
    if [ -n "$mod" ]; then carregar "$mod" "PCI $id $desc"; else log "??  PCI $id $desc (sem driver na tabela, o kernel pode cuidar sozinho)"; fi
  done < <(lspci -nn | grep -iE 'network|ethernet|wireless|wi-fi')
fi
if command -v lsusb >/dev/null; then
  while read -r linha; do
    id=$(awk '{print $6}' <<<"$linha")
    mod=$(achar_mod "$id" USB_MOD)
    [ -n "$mod" ] && carregar "$mod" "USB $id $(cut -d' ' -f7- <<<"$linha" | cut -c1-60)"
  done < <(lsusb)
fi

# Firmware faltando?
if dmesg 2>/dev/null | grep -iE 'firmware: failed|direct firmware load .* failed' | tail -5 | grep -q .; then
  log "AVISO: falta firmware. Veja: dmesg | grep -i firmware"
  dmesg | grep -iE 'direct firmware load .* failed' | tail -5 | while read -r l; do log "  $l"; done
fi

# Libera o rádio (Wi-Fi bloqueado por software) e deixa o NetworkManager gerenciar tudo
(( RELATORIO )) || { command -v rfkill >/dev/null && rfkill unblock wifi 2>/dev/null; }
(( RELATORIO )) || { command -v nmcli >/dev/null && nmcli radio wifi on 2>/dev/null && nmcli networking on 2>/dev/null; }

log "Interfaces:"
for i in /sys/class/net/*; do
  n=$(basename "$i"); [ "$n" = lo ] && continue
  drv=$(basename "$(readlink -f "$i/device/driver" 2>/dev/null)" 2>/dev/null)
  log "  $n  estado=$(cat "$i/operstate")  driver=${drv:-?}  mac=$(cat "$i/address")"
done
exit 0
