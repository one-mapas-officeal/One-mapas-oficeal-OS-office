#!/bin/sh
set -e
lb config noauto \
  --mode debian \
  --distribution bookworm \
  --architectures amd64 \
  --archive-areas "main contrib non-free non-free-firmware" \
  --binary-images iso-hybrid \
  --bootloaders "grub-efi syslinux" \
  --debian-installer none \
  --memtest none \
  --iso-application "OneMapas OS" \
  --iso-publisher "One Mapas Office" \
  --iso-volume "ONEMAPAS_OS" \
  --bootappend-live "boot=live components quiet splash username=onemapas user-fullname=OneMapas hostname=onemapas-pc locales=pt_BR.UTF-8 keyboard-layouts=br timezone=America/Sao_Paulo" \
  "${@}"
